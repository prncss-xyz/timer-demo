{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"waku.config.ts!",
		"src/waku.server.tsx!",
		"src/pages/**/*.{ts,tsx}!"
	],
	"project": ["src/**/*.{ts,tsx}!"],
	"ignore": [
		"src/messages.ts",
		"src/pages.gen.ts",
		"src/layouts/MD/*",
		"src/layouts/images/*",
		"src/layouts/elements/*",
		"src/layouts/Box.tsx",
		"src/layouts/tokens/*.stylex.ts",
		"src/utils/messages/*",
		"src/features/darkMode/*",
		"src/fixtures/*",
		"src/**/*.story.{ts,tsx}",
		"src/test.setup.ts",
		"src/utils/fontConstants.ts"
	],
	"ignoreDependencies": [
		"playwright-core",
		"@commitlint/cli",
		"@base-ui/react",
		"@sindresorhus/slugify",
		"react-icons",
		"rehype-react",
		"rehype-sanitize",
		"rehype-stringify",
		"remark-breaks",
		"remark-gfm",
		"remark-parse",
		"remark-rehype",
		"sharp",
		"unified",
		"content-collections"
	],
	"ignoreBinaries": ["vpr"]
}
