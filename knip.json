{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"entry": [
		"waku.config.ts!",
		"src/waku.server.tsx!",
		"src/pages/**/*.{ts,tsx}!"
	],
	"project": ["src/**/*.{ts,tsx}!"],
	"ignore": [
		"src/pages.gen.ts",
		"src/components/MD/*",
		"src/components/images/*",
		"src/components/elements/*",
		"src/components/Box.tsx",
		"src/components/tokens.stylex.ts",
		"src/basePath.ts"
	],
	"ignoreDependencies": [
		"@commitlint/cli",
		"@base-ui/react",
		"@sindresorhus/slugify",
		"react-icons",
		"rehype-react",
		"rehype-sanitize",
		"rehype-stringify",
		"remark-breaks",
		"remark-gfm",
		"remark-parse",
		"remark-rehype",
		"sharp",
		"unified"
	],
	"ignoreBinaries": ["vpr"]
}
