{
	"compilerOptions": {
		"strict": true,
		"target": "esnext",
		"noEmit": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"types": ["vite-plus/test/globals"],
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
